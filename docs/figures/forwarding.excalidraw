    {
      "id": "note-checks",
      "type": "text",
      "x": 40,
      "y": 120,
      "width": 884,
      "height": 22,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1037,
      "version": 1,
      "versionNonce": 7262,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 18,
      "fontFamily": 1,
      "text": "NAT needs IPv4, TCP or UDP, and --vip. A backend needs a pin or Ketama hit, plus a MAC.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NAT needs IPv4, TCP or UDP, and --vip. A backend needs a pin or Ketama hit, plus a MAC.",
      "lineHeight": 1.25,
      "baseline": 5
    },
    {
      "id": "note-port",
      "type": "text",
      "x": 1220,
      "y": 565,
      "width": 219,
      "height": 67,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1038,
      "version": 1,
      "versionNonce": 7269,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 18,
      "fontFamily": 1,
      "text": "The rewrite allocates\na port and binds\nconntrack.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The rewrite allocates\na port and binds\nconntrack.",
      "lineHeight": 1.25,
      "baseline": 5
    },
